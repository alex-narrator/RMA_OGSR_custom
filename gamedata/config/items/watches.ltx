;;	WRISTWATCHES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
[watch_base]:identity_immunities
GroupControlSection		= spawn_group
discovery_dependency	=
$spawn					= "devices\wristwatch"
cform                   = skeleton
class					= II_ATTCH
slot					= 10

inv_weight				= .1

inv_grid_width			= 1
inv_grid_height			= 1

[watch_montana]:watch_base
visual                  = dynamics\devices\dev_wristwatch\montana

cost					= 2000

icon_name 				= ui\items\wristwatch\montana_icon

inv_name				= st_watch_montana_name
inv_name_short			= st_watch_montana_short
description				= st_watch_montana_descr

hands_attach_hud 		= watch_montana_hud

