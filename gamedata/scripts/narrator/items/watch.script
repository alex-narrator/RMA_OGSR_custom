-- -*- mode: lua; coding: windows-1251-dos -*-
function attach(sm)
	sm:subscribe({signal = "on_key_press",  fun = this.on_key_press})
	-- sm:subscribe({signal = "on_key_release",  fun = this.on_key_release})
	sm:subscribe({signal = "on_slot", 		fun = this.on_slot})
	sm:subscribe({signal = "on_drop", 		fun = this.on_non_slot})
	sm:subscribe({signal = "on_ruck", 		fun = this.on_non_slot})
	sm:subscribe({signal = "on_hud_state_switch", 	fun = this.on_state_switch})
	sm:subscribe({signal = "on_actor_weapon_zoom_in",   fun = this.on_zoom_in})
end

local anim_hud_sect = "wristwatch_check_wd"

local anim_name = {
	["show"] = "anm_show",
	["hide"] = "anm_hide",
	["idle"] = "anm_idle",
}

local hud_anims = {
	["show"] = "camera_effects\\watch\\cam_leer_watch_in.anm",
	["hide"] = "camera_effects\\watch\\cam_leer_watch_out.anm",
	["idle"] = "camera_effects\\watch\\cam_leer_watch_idle.anm",
}

local postfix = {
	["detector_geiger_cop"] = "dosimeter",
	["detector_diy_cop"] = "dosimeter",
	["detector_receiver_cop"] = "radio",
	["detector_simple_cop"] = "echo",
	["detector_advanced_cop"] = "bear",
	["detector_elite_cop"] = "veles",
	["detector_bio_cop"] = "veles",
	["device_tactical_torch"] = "flashlight",
	["device_flashlight"] = "flashlight",
}

function get_anim_data(anim_type, sect)
	local add = postfix[sect] and "_"..postfix[sect] or ""
	return anim_hud_sect..add, anim_name[anim_type]
end

local hide_device = false
local mix_anim = true

local current_watch = nil

function on_slot(obj, prev_place)
	if obj:get_slot() ~= ARTEFACT_SLOT then
	return end
	local attach_hud_sect = read_if_exists(sys_ini, "string", obj:section(), "hands_attach_hud", nil)
	if not attach_hud_sect then
	return end
	local attach_name = read_if_exists(sys_ini, "string", attach_hud_sect, "attach_name", nil)
	if not attach_name then
	return end
	local attachment = game.add_hud_hands_attachment(attach_name, attach_hud_sect)
	local backlight_color = read_if_exists(sys_ini, "vector", attach_hud_sect, "backlight_color", vector())
	shader_set_custom_param("watch_backlight_color", 0, 0, 0, 0)
	local glow_color = read_if_exists(sys_ini, "vector", attach_hud_sect, "glow_color", vector())
	shader_set_custom_param("watch_glow_color", glow_color.x, glow_color.y, glow_color.z, 0)
	
	current_watch = {
		name = attach_name,
		attachment = attachment,
		color = backlight_color,
		glow = glow_color,
	}
end

function on_non_slot(obj, prev_place)
	if prev_place ~= inv_place.slot then
	return end
	if obj:get_slot() ~= ARTEFACT_SLOT then
	return end
	if not current_watch then
	return end
	local attach_hud_sect = read_if_exists(sys_ini, "string", obj:section(), "hands_attach_hud", nil)
	if not attach_hud_sect then
	return end
	local attach_name = read_if_exists(sys_ini, "string", attach_hud_sect, "attach_name", nil)
	if not attach_name then
	return end	
	game.remove_hud_hands_attachment(attach_name)
	current_watch = nil
	shader_set_custom_param("watch_backlight_color", 0, 0, 0, 0)
	shader_set_custom_param("watch_glow_color", 0, 0, 0, 0)
	ui_watch.clear_ui()
end

function on_key_press(key, game_action)
	if anim_playing then
		stop_watch_anim()
	return end
	if level.main_input_receiver() or
		(not actor_hands_free() and not anim_playing) or
		game_action ~= key_bindings.kWPN_7 then
	return end
	if not current_watch then
	return end
	if anim_playing then
		stop_watch_anim()
	else
		start_watch_anim()
	end
end

function play_show_anim(device_sect)
	local _type = "show"
	level.add_cam_effector(hud_anims[_type], 6666666, false, "")
	local sect, name = get_anim_data(_type, device_sect)
	local anm_length = game.play_hud_motion(1, sect, name, mix_anim, 1, hide_device)
	add_time_delayed_action(
		anm_length * 0.001 * 0.95,
		function()
			if anim_playing then
				play_idle_anim()
			end
		end,
		function()
			return not anim_playing
		end
	)
end

function play_idle_anim(device_sect)
	local _type = "idle"
	local sect, name = get_anim_data(_type, device_sect)
	game.play_hud_motion(1, sect, name, mix_anim, 1, hide_device)
	local color = current_watch.color
	shader_set_custom_param("watch_backlight_color", color.x, color.y, color.z, 0)	
end

function play_hide_anim(device_sect)
	local _type = "hide"
	level.add_cam_effector(hud_anims[_type], 6666666, false, "")
	local sect, name = get_anim_data(_type, device_sect)
	local anm_length = game.play_hud_motion(1, sect, name, mix_anim, 1, hide_device)
	shader_set_custom_param("watch_backlight_color", 0, 0, 0, 0)
end

function start_watch_anim()
	local act_item = actor:active_item()
	local act_device = actor:active_device()
	local device_sect = act_device and act_device:section()
	if act_item or act_device then
		if act_item then
			act_item:zoom_out()
		end
		play_idle_anim(device_sect)
	else
		play_show_anim(device_sect)
	end
	anim_playing = true
	play_sound()
end

function stop_watch_anim()
	if not current_watch then
	return end
	if not anim_playing then
	return end
	anim_playing = false
	shader_set_custom_param("watch_backlight_color", 0, 0, 0, 0)
	if actor:active_item() or actor:active_device() then
		game.stop_hud_motion()
	else
		local device_sect = actor:active_device() and actor:active_device():section() or nil
		play_hide_anim(device_sect)
	end
	play_sound()
end

function play_sound()
	local sound = xr_sound.get_safe_sound_object("interface\\item_usage\\pickup")
	sound:play(actor, 0, sound_object.s2d)
	sound.volume = 0.5
end

function on_key_release(key, game_action)
	if level.main_input_receiver() or 
		game_action ~= key_bindings.kWPN_7 then
	return end
	stop_watch_anim()
end

function on_state_switch(item, state, old_state)
	stop_watch_anim()
end

function on_zoom_in(item)
	stop_watch_anim()
end