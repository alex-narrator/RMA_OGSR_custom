	self.work_area = xml:InitStatic(root, self)
	
	local time_root = root..":time"
	self.time = xml:InitStatic(time_root, self.work_area)
	self.hour_1 = xml:InitStatic(time_root..":hour_1", self.time)
	self.hour_2 = xml:InitStatic(time_root..":hour_2", self.time)
	self.minute_1 = xml:InitStatic(time_root..":minute_1", self.time)
	self.minute_2 = xml:InitStatic(time_root..":minute_2", self.time)
	self.work = xml:InitStatic(time_root..":work", self.time)

	local date_root = root..":date"
	self.date = xml:InitStatic(date_root, self.work_area)
	self.day_1 = xml:InitStatic(date_root..":day_1", self.date)
	self.day_2 = xml:InitStatic(date_root..":day_2", self.date)
	self.month_1 = xml:InitStatic(date_root..":month_1", self.date)
	self.month_2 = xml:InitStatic(date_root..":month_2", self.date)
	
	self.indicator_time = 0
	self.indicator_switch_delay = 500	
	
	self:SetAutoDelete(true)
end

function UINorthEdge:__finalize()
end

function UINorthEdge:Update()
	CUIScriptWnd.Update(self)
	
	local tg = time_global()
	
	if (tg > self.indicator_time + self.indicator_switch_delay) then
		self.indicator_time = tg
		self.work:Show(not self.work:IsShown())
	end	
	
	local hours = level.get_time_hours()
	local minutes = level.get_time_minutes()

	local hour_angle = -(hours + minutes / 60) * time_hour_rad
	local minute_angle = -minutes * time_minute_rad

	shader_set_custom_param("clock_time_angle", hour_angle, minute_angle)
	
	local hours = level.get_time_hours()
	local minutes = level.get_time_minutes()

	--log_news("hours [%s] minutes [%s]", hours, minutes)
	local hour_1, hour_2, minute_1, minute_2 = "letter_digit_0", "letter_digit_0", "letter_digit_0", "letter_digit_0"
	
	if hours < 10 then
		hour_2 = string.format("letter_digit_%s", tostring(hours):sub(1, 1))
	else
		hour_1 = string.format("letter_digit_%s", tostring(hours):sub(1, 1))
		hour_2 = string.format("letter_digit_%s", tostring(hours):sub(2, 2))	
	end

	if minutes < 10 then
		minute_2 = string.format("letter_digit_%s", tostring(minutes):sub(1, 1))
	else
		minute_1 = string.format("letter_digit_%s", tostring(minutes):sub(1, 1))
		minute_2 = string.format("letter_digit_%s", tostring(minutes):sub(2, 2))	
	end
	
	self.hour_1:InitTextureEx(hour_1, "hud\\p3d")
	self.hour_2:InitTextureEx(hour_2, "hud\\p3d")
	self.minute_1:InitTextureEx(minute_1, "hud\\p3d")
	self.minute_2:InitTextureEx(minute_2, "hud\\p3d")
	
	local _time = game.get_game_time()
	local date_str = _time:dateToString(game.CTime.DateToDay)
	local day_1, day_2, month_1, month_2
	day_1 = string.format("letter_digit_%s", date_str:sub(1, 1))
	day_2 = string.format("letter_digit_%s", date_str:sub(2, 2))
	month_1 = string.format("letter_digit_%s", date_str:sub(4, 4))
	month_2 = string.format("letter_digit_%s", date_str:sub(5, 5))
	
	self.day_1:InitTextureEx(day_1, "hud\\p3d")
	self.day_2:InitTextureEx(day_2, "hud\\p3d")
	self.month_1:InitTextureEx(month_1, "hud\\p3d")
	self.month_2:InitTextureEx(month_2, "hud\\p3d")
end

