class "UIFenix" (CUIScriptWnd)
function UIFenix:__init(attachment) super()
	self:Show(true)
	self:Enable(true)

	local xml = CScriptXmlInit()
	self.xml = xml
	xml:ParseFile(OVERLAY_XML)
	local root = "display_fenix"
	xml:InitWindow(root, 0, self)
	
	root = root..":display"
	self.display = xml:InitStatic(root, self)
	
	local time_root = root..":time"
	self.time = xml:InitStatic(time_root, self.display)
	self.hour_1 = xml:InitStatic(time_root..":hour_1", self.time)
	self.hour_2 = xml:InitStatic(time_root..":hour_2", self.time)
	self.minute_1 = xml:InitStatic(time_root..":minute_1", self.time)
	self.minute_2 = xml:InitStatic(time_root..":minute_2", self.time)
	self.work = xml:InitStatic(time_root..":work", self.time)

	local date_root = root..":date"
	self.date = xml:InitStatic(date_root, self.display)
	self.day_1 = xml:InitStatic(date_root..":day_1", self.date)
	self.day_2 = xml:InitStatic(date_root..":day_2", self.date)
	self.date_sep_1 = xml:InitStatic(date_root..":date_sep_1", self.date)	
	self.month_1 = xml:InitStatic(date_root..":month_1", self.date)
	self.month_2 = xml:InitStatic(date_root..":month_2", self.date)
	self.date_sep_2 = xml:InitStatic(date_root..":date_sep_2", self.date)
	self.year_1 = xml:InitStatic(date_root..":year_1", self.date)
	self.year_2 = xml:InitStatic(date_root..":year_2", self.date)

	local target_root = root..":target"
	self.target = xml:InitStatic(target_root, self.display)
	self.dist_1 = xml:InitStatic(target_root..":dist_1", self.target)
	self.dist_2 = xml:InitStatic(target_root..":dist_2", self.target)
	self.dist_3 = xml:InitStatic(target_root..":dist_3", self.target)
	self.dist_m = xml:InitStatic(target_root..":dist_m", self.target)	
	self.pointer = xml:InitStatic(target_root..":pointer", self.target)
	
	self.new_message = xml:InitStatic(root..":new_message", self.display)
	
	self.attachment = attachment
	
	self.indicator_time = 0
	self.indicator_switch_delay = 500
	
	self:SetAutoDelete(true)
end

function UIFenix:__finalize() 
end

function UIFenix:Update()
	CUIScriptWnd.Update(self)
	
	local tg = time_global()
	
	if (tg > self.indicator_time + self.indicator_switch_delay) then
		self.indicator_time = tg
		self.work:Show(not self.work:IsShown())
	end	
	
	local hours = level.get_time_hours()
	local minutes = level.get_time_minutes()

	--log_news("hours [%s] minutes [%s]", hours, minutes)
	local hour_1, hour_2, minute_1, minute_2 = "letter_digit_0", "letter_digit_0", "letter_digit_0", "letter_digit_0"
	
	if hours < 10 then
		hour_2 = string.format("letter_digit_%s", tostring(hours):sub(1, 1))
	else
		hour_1 = string.format("letter_digit_%s", tostring(hours):sub(1, 1))
		hour_2 = string.format("letter_digit_%s", tostring(hours):sub(2, 2))	
	end

	if minutes < 10 then
		minute_2 = string.format("letter_digit_%s", tostring(minutes):sub(1, 1))
	else
		minute_1 = string.format("letter_digit_%s", tostring(minutes):sub(1, 1))
		minute_2 = string.format("letter_digit_%s", tostring(minutes):sub(2, 2))	
	end
	
	self.hour_1:InitTextureEx(hour_1, "hud\\p3d")
	self.hour_2:InitTextureEx(hour_2, "hud\\p3d")
	self.minute_1:InitTextureEx(minute_1, "hud\\p3d")
	self.minute_2:InitTextureEx(minute_2, "hud\\p3d")
	
	local _time = game.get_game_time()
	local date_str = _time:dateToString(game.CTime.DateToDay)
	local day_1, day_2, month_1, month_2, year_1, year_2
	day_1 = string.format("letter_digit_%s", date_str:sub(1, 1))
	day_2 = string.format("letter_digit_%s", date_str:sub(2, 2))
	month_1 = string.format("letter_digit_%s", date_str:sub(4, 4))
	month_2 = string.format("letter_digit_%s", date_str:sub(5, 5))
	year_1 = string.format("letter_digit_%s", date_str:sub(9, 9))
	year_2 = string.format("letter_digit_%s", date_str:sub(10, 10))	
	
	self.day_1:InitTextureEx(day_1, "hud\\p3d")
	self.day_2:InitTextureEx(day_2, "hud\\p3d")
	self.month_1:InitTextureEx(month_1, "hud\\p3d")
	self.month_2:InitTextureEx(month_2, "hud\\p3d")
	self.year_1:InitTextureEx(year_1, "hud\\p3d")
	self.year_2:InitTextureEx(year_2, "hud\\p3d")
	
	local pos, dist = ui_map_utils.get_selected_target_pos_dist()
	local show_target = actor_get_pda() and actor_get_pda():is_power_on() and pos
	self.target:Show(show_target)
	if show_target then
		local heading = ui_map_utils.get_selected_target_heading(pos)
		self.pointer:SetHeading(heading)
		
		local dist_1, dist_2, dist_3 = "letter_digit_0", "letter_digit_0", "letter_digit_0"
		dist = math.clamp(dist, 0, 999)
		if dist < 10 then
			dist_3 = string.format("letter_digit_%s", tostring(dist):sub(1, 1))
		elseif dist < 100 then
			dist_2 = string.format("letter_digit_%s", tostring(dist):sub(1, 1))
			dist_3 = string.format("letter_digit_%s", tostring(dist):sub(2, 2))
		else
			dist_1 = string.format("letter_digit_%s", tostring(dist):sub(1, 1))
			dist_2 = string.format("letter_digit_%s", tostring(dist):sub(2, 2))
			dist_3 = string.format("letter_digit_%s", tostring(dist):sub(3, 3))		
		end
		self.dist_1:InitTextureEx(dist_1, "hud\\p3d")
		self.dist_2:InitTextureEx(dist_2, "hud\\p3d")
		self.dist_3:InitTextureEx(dist_3, "hud\\p3d")
	end
	
	self.new_message:Show(main_window.flashing_icon:IsShown())
end

