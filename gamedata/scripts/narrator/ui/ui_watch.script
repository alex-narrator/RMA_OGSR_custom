local watch_overlays = {
	["watch_montana_hud"] 			= UIMontana,
	["watch_garmin_fenix_hud"] 		= UIFenix,
	["watch_garmin_tactix_hud"] 	= UITactix,
	["watch_suunto_core_hud"] 		= UISuunto,
	["watch_luminox_recon_hud"] 	= UILuminox,
	["watch_rolex_gmt_master_hud"] 	= UIRolex,
	["watch_traser_automatic_hud"] 	= UITraserAutomatic,
	["watch_traser_p66_hud"] 		= UITraserP66,
	["watch_north_edge_hud"] 		= UINorthEdge,
}

function get_ui(attachment)
	clear_ui()
	if not attachment then
	return end
	local overlay = watch_overlays[attachment:section()]
	if overlay then
		watch_overlay = overlay(attachment)
	end
	return watch_overlay
end

function clear_ui()
	watch_overlay = nil
end