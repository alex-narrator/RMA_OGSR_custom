class "UITactix" (CUIScriptWnd)
function UITactix:__init(attachment) super()
	self:Show(true)
	self:Enable(true)

	local xml = CScriptXmlInit()
	self.xml = xml
	xml:ParseFile(OVERLAY_XML)
	local root = "display_tactix"
	xml:InitWindow(root, 0, self)
	
	root = root..":display"
	self.display = xml:InitStatic(root, self)
	
	local time_root = root..":time"
	self.time = xml:InitStatic(time_root, self.display)
	self.hour_1 = xml:InitStatic(time_root..":hour_1", self.time)
	self.hour_2 = xml:InitStatic(time_root..":hour_2", self.time)
	self.minute_1 = xml:InitStatic(time_root..":minute_1", self.time)
	self.minute_2 = xml:InitStatic(time_root..":minute_2", self.time)
	self.work = xml:InitStatic(time_root..":work", self.time)

	local date_root = root..":date"
	self.date = xml:InitStatic(date_root, self.display)
	self.day_1 = xml:InitStatic(date_root..":day_1", self.date)
	self.day_2 = xml:InitStatic(date_root..":day_2", self.date)
	self.date_sep_1 = xml:InitStatic(date_root..":date_sep_1", self.date)	
	self.month_1 = xml:InitStatic(date_root..":month_1", self.date)
	self.month_2 = xml:InitStatic(date_root..":month_2", self.date)
	self.date_sep_2 = xml:InitStatic(date_root..":date_sep_2", self.date)
	self.year_1 = xml:InitStatic(date_root..":year_1", self.date)
	self.year_2 = xml:InitStatic(date_root..":year_2", self.date)

	local target_root = root..":target"
	self.target = xml:InitStatic(target_root, self.display)
	self.dist_1 = xml:InitStatic(target_root..":dist_1", self.target)
	self.dist_2 = xml:InitStatic(target_root..":dist_2", self.target)
	self.dist_3 = xml:InitStatic(target_root..":dist_3", self.target)
	self.dist_m = xml:InitStatic(target_root..":dist_m", self.target)
	self.pointer = xml:InitStatic(target_root..":pointer", self.target)

	local azimuth_root = root..":azimuth"
	self.azimuth = xml:InitStatic(azimuth_root, self.display)
	self.angle_1 = xml:InitStatic(azimuth_root..":angle_1", self.azimuth)
	self.angle_2 = xml:InitStatic(azimuth_root..":angle_2", self.azimuth)
	self.angle_3 = xml:InitStatic(azimuth_root..":angle_3", self.azimuth)
	self.angle_o = xml:InitStatic(azimuth_root..":angle_o", self.azimuth)
	
	self.compass = xml:InitStatic(root..":compass", self.display)
	
	self.new_message = xml:InitStatic(root..":new_message", self.display)
	
	self.attachment = attachment
	
	self.indicator_time = 0
	self.indicator_switch_delay = 500
	
	self:SetAutoDelete(true)
end

function UITactix:__finalize() 
end

function UITactix:Update()
	CUIScriptWnd.Update(self)
	
	local tg = time_global()
	
	if (tg > self.indicator_time + self.indicator_switch_delay) then
		self.indicator_time = tg
		self.work:Show(not self.work:IsShown())
	end	
	
	local hours = level.get_time_hours()
	local minutes = level.get_time_minutes()

	--log_news("hours [%s] minutes [%s]", hours, minutes)
	local hour_1, hour_2, minute_1, minute_2 = "letter_digit_0", "letter_digit_0", "letter_digit_0", "letter_digit_0"
	
	if hours < 10 then
		hour_2 = string.format("letter_digit_%s", tostring(hours):sub(1, 1))
	else
		hour_1 = string.format("letter_digit_%s", tostring(hours):sub(1, 1))
		hour_2 = string.format("letter_digit_%s", tostring(hours):sub(2, 2))	
	end

	if minutes < 10 then
		minute_2 = string.format("letter_digit_%s", tostring(minutes):sub(1, 1))
	else
		minute_1 = string.format("letter_digit_%s", tostring(minutes):sub(1, 1))
		minute_2 = string.format("letter_digit_%s", tostring(minutes):sub(2, 2))	
	end
	
	self.hour_1:InitTextureEx(hour_1, "hud\\p3d")
	self.hour_2:InitTextureEx(hour_2, "hud\\p3d")
	self.minute_1:InitTextureEx(minute_1, "hud\\p3d")
	self.minute_2:InitTextureEx(minute_2, "hud\\p3d")
	
	local _time = game.get_game_time()
	local date_str = _time:dateToString(game.CTime.DateToDay)
	local day_1, day_2, month_1, month_2, year_1, year_2
	day_1 = string.format("letter_digit_%s", date_str:sub(1, 1))
	day_2 = string.format("letter_digit_%s", date_str:sub(2, 2))
	month_1 = string.format("letter_digit_%s", date_str:sub(4, 4))
	month_2 = string.format("letter_digit_%s", date_str:sub(5, 5))
	year_1 = string.format("letter_digit_%s", date_str:sub(9, 9))
	year_2 = string.format("letter_digit_%s", date_str:sub(10, 10))	
	
	self.day_1:InitTextureEx(day_1, "hud\\p3d")
	self.day_2:InitTextureEx(day_2, "hud\\p3d")
	self.month_1:InitTextureEx(month_1, "hud\\p3d")
	self.month_2:InitTextureEx(month_2, "hud\\p3d")
	self.year_1:InitTextureEx(year_1, "hud\\p3d")
	self.year_2:InitTextureEx(year_2, "hud\\p3d")
	
	local pos, dist = ui_map_utils.get_selected_target_pos_dist()
	local show_target = actor_get_pda() and actor_get_pda():is_power_on() and pos
	self.target:Show(show_target)
	self.azimuth:Show(not show_target)
	
	local h = device().cam_dir:getH()
	self.compass:SetHeading(-h)
	
	if show_target then
		local heading = ui_map_utils.get_selected_target_heading(pos)
		self.pointer:SetHeading(heading)
		
		local dist_1, dist_2, dist_3 = "letter_digit_0", "letter_digit_0", "letter_digit_0"
		dist = math.clamp(dist, 0, 999)
		if dist < 10 then
			dist_3 = string.format("letter_digit_%s", tostring(dist):sub(1, 1))
		elseif dist < 100 then
			dist_2 = string.format("letter_digit_%s", tostring(dist):sub(1, 1))
			dist_3 = string.format("letter_digit_%s", tostring(dist):sub(2, 2))
		else
			dist_1 = string.format("letter_digit_%s", tostring(dist):sub(1, 1))
			dist_2 = string.format("letter_digit_%s", tostring(dist):sub(2, 2))
			dist_3 = string.format("letter_digit_%s", tostring(dist):sub(3, 3))		
		end
		self.dist_1:InitTextureEx(dist_1, "hud\\p3d")
		self.dist_2:InitTextureEx(dist_2, "hud\\p3d")
		self.dist_3:InitTextureEx(dist_3, "hud\\p3d")
	else
		local angle = math.deg(-h)
		angle = angle < 0 and angle + 360 or angle
		angle = math.round(angle)

		local angle_1, angle_2, angle_3 = "letter_digit_0", "letter_digit_0", "letter_digit_0"
		if angle < 10 then
			angle_3 = string.format("letter_digit_%s", tostring(angle):sub(1, 1))
		elseif angle < 100 then
			angle_2 = string.format("letter_digit_%s", tostring(angle):sub(1, 1))
			angle_3 = string.format("letter_digit_%s", tostring(angle):sub(2, 2))
		else
			angle_1 = string.format("letter_digit_%s", tostring(angle):sub(1, 1))
			angle_2 = string.format("letter_digit_%s", tostring(angle):sub(2, 2))
			angle_3 = string.format("letter_digit_%s", tostring(angle):sub(3, 3))		
		end
		self.angle_1:InitTextureEx(angle_1, "hud\\p3d")
		self.angle_2:InitTextureEx(angle_2, "hud\\p3d")
		self.angle_3:InitTextureEx(angle_3, "hud\\p3d")		
	end
	
	self.new_message:Show(main_window.flashing_icon:IsShown())
end

---///////////////////////////////////////////////////////////////////////////////////////////////////////

class "UISuunto" (CUIScriptWnd)
function UISuunto:__init(attachment) super()
	self.attachment = attachment
	self:InitControls()
	self:Subscribe()
	self:SetAutoDelete(true)
end

function UISuunto:__finalize()
	self:Unsubscribe()
end

function UISuunto:Subscribe()
	if not self.subscribed then
		self.subscribed = {
			{signal = "on_mouse_wheel", self = self, fun = self.OnMouseWheel},
		}
		local sm = ogsr_signals.get_mgr()
		for _, s in ipairs( self.subscribed ) do
			sm:subscribe( s )
		end
	end
end

function UISuunto:Unsubscribe()
	if self.subscribed then
		local sm = ogsr_signals.get_mgr()
		for _, s in ipairs( self.subscribed ) do
			sm:unsubscribe( s )
		end
		self.subscribed = false
	end
end

function UISuunto:InitControls()
	self:Show(true)
	self:Enable(true)

	local xml = CScriptXmlInit()
	self.xml = xml
	xml:ParseFile(OVERLAY_XML)
	local root = "display_suunto"
	xml:InitWindow(root, 0, self)
	
	self.displays = {}
	
	--//time display
	local display_root = root..":display_time"
	self.display_time = xml:InitStatic(root, self)
	table.insert(self.displays, self.display_time)
	
	local time_root = display_root..":time"
	self.time = xml:InitStatic(time_root, self.display_time)
	self.hour_1 = xml:InitStatic(time_root..":hour_1", self.time)
	self.hour_2 = xml:InitStatic(time_root..":hour_2", self.time)
	self.minute_1 = xml:InitStatic(time_root..":minute_1", self.time)
	self.minute_2 = xml:InitStatic(time_root..":minute_2", self.time)
	self.work = xml:InitStatic(time_root..":work", self.time)

	local date_root = display_root..":date"
	self.date = xml:InitStatic(date_root, self.display_time)
	self.day_1 = xml:InitStatic(date_root..":day_1", self.date)
	self.day_2 = xml:InitStatic(date_root..":day_2", self.date)
	self.date_sep_1 = xml:InitStatic(date_root..":date_sep_1", self.date)	
	self.month_1 = xml:InitStatic(date_root..":month_1", self.date)
	self.month_2 = xml:InitStatic(date_root..":month_2", self.date)
	self.date_sep_2 = xml:InitStatic(date_root..":date_sep_2", self.date)
	self.year_1 = xml:InitStatic(date_root..":year_1", self.date)
	self.year_2 = xml:InitStatic(date_root..":year_2", self.date)
	
	self.new_message = xml:InitStatic(display_root..":new_message", self.display_time)
	
	self.indicator_time = 0
	self.indicator_switch_delay = 500
	
	--//condition bars display
	local display_root = root..":display_conditions"
	self.display_conditions = xml:InitStatic(root, self)
	table.insert(self.displays, self.display_conditions)
	
	local health_root = display_root..":progress_health"
	self.progress_health = xml:InitProgressShape(health_root, self.display_conditions)
	
	local power_root = display_root..":progress_power"
	self.progress_power = xml:InitProgressShape(power_root, self.display_conditions)

	local bleeding_root = display_root..":bleeding"
	self.bleeding = xml:InitStatic(bleeding_root, self.display_conditions)
	
	self.bleeding_indicator_time = 0
	self.bleeding_indicator_switch_delay = xml:ReadAttribFlt(bleeding_root, "blink_delay", "0")	
	
	--//navigation display
	local display_root = root..":display_navigation"
	self.display_navigation = xml:InitStatic(root, self)
	table.insert(self.displays, self.display_navigation)
	self.minimap = ui_minimap.UIMiniMap(self.xml, self.display_navigation, display_root, true)

	--//compass display
	local display_root = root..":display_compass"
	self.display_compass = xml:InitStatic(root, self)
	
	local target_root = display_root..":target"
	self.target = xml:InitStatic(target_root, self.display_compass)
	self.dist_1 = xml:InitStatic(target_root..":dist_1", self.target)
	self.dist_2 = xml:InitStatic(target_root..":dist_2", self.target)
	self.dist_3 = xml:InitStatic(target_root..":dist_3", self.target)
	self.dist_m = xml:InitStatic(target_root..":dist_m", self.target)
	self.pointer = xml:InitStatic(target_root..":pointer", self.target)

	local azimuth_root = display_root..":azimuth"
	self.azimuth = xml:InitStatic(azimuth_root, self.display_compass)
	self.angle_1 = xml:InitStatic(azimuth_root..":angle_1", self.azimuth)
	self.angle_2 = xml:InitStatic(azimuth_root..":angle_2", self.azimuth)
	self.angle_3 = xml:InitStatic(azimuth_root..":angle_3", self.azimuth)
	self.angle_o = xml:InitStatic(azimuth_root..":angle_o", self.azimuth)
	
	self.compass = xml:InitStatic(display_root..":compass", self.display_compass)
end

function UISuunto:Update()
	CUIScriptWnd.Update(self)
	self:UpdateCompass()	
	self:UpdateTime()
	self:UpdateConditions()
	self:UpdateNavigation()
end

function UISuunto:OnMouseWheel(forward)
	if not key_state(bind_to_dik(key_bindings.kADDITIONAL_ACTION)) then
	return end
	if self.minimap:IsShown() then
		if forward then
			self.minimap:IncZoom()
		else
			self.minimap:DecZoom()
		end
	end
end

function UISuunto:UpdateCompass()
	self.display_compass:Show(self.display_time:IsShown())
	if not self.display_compass:IsShown() then
	return end
	
	local pos, dist = ui_map_utils.get_selected_target_pos_dist()
	local show_target = actor_get_pda() and actor_get_pda():is_power_on() and pos
	self.target:Show(show_target)
	self.azimuth:Show(not show_target)
	
	local h = device().cam_dir:getH()
	self.compass:SetHeading(-h)
	
	-- self.static_test:SetHeading(-h)
	
	if show_target then
		local heading = ui_map_utils.get_selected_target_heading(pos)
		self.pointer:SetHeading(heading)
		
		local dist_1, dist_2, dist_3 = "letter_digit_0", "letter_digit_0", "letter_digit_0"
		dist = math.clamp(dist, 0, 999)
		if dist < 10 then
			dist_3 = string.format("letter_digit_%s", tostring(dist):sub(1, 1))
		elseif dist < 100 then
			dist_2 = string.format("letter_digit_%s", tostring(dist):sub(1, 1))
			dist_3 = string.format("letter_digit_%s", tostring(dist):sub(2, 2))
		else
			dist_1 = string.format("letter_digit_%s", tostring(dist):sub(1, 1))
			dist_2 = string.format("letter_digit_%s", tostring(dist):sub(2, 2))
			dist_3 = string.format("letter_digit_%s", tostring(dist):sub(3, 3))		
		end
		self.dist_1:InitTextureEx(dist_1, "hud\\p3d")
		self.dist_2:InitTextureEx(dist_2, "hud\\p3d")
		self.dist_3:InitTextureEx(dist_3, "hud\\p3d")
	else
		local angle = math.deg(-h)
		angle = angle < 0 and angle + 360 or angle
		angle = math.round(angle)

		local angle_1, angle_2, angle_3 = "letter_digit_0", "letter_digit_0", "letter_digit_0"
		if angle < 10 then
			angle_3 = string.format("letter_digit_%s", tostring(angle):sub(1, 1))
		elseif angle < 100 then
			angle_2 = string.format("letter_digit_%s", tostring(angle):sub(1, 1))
			angle_3 = string.format("letter_digit_%s", tostring(angle):sub(2, 2))
		else
			angle_1 = string.format("letter_digit_%s", tostring(angle):sub(1, 1))
			angle_2 = string.format("letter_digit_%s", tostring(angle):sub(2, 2))
			angle_3 = string.format("letter_digit_%s", tostring(angle):sub(3, 3))		
		end
		self.angle_1:InitTextureEx(angle_1, "hud\\p3d")
		self.angle_2:InitTextureEx(angle_2, "hud\\p3d")
		self.angle_3:InitTextureEx(angle_3, "hud\\p3d")		
	end
end

function UISuunto:UpdateTime()
	if not self.display_time:IsShown() then
	return end
	
	local tg = time_global()
	
	if (tg > self.indicator_time + self.indicator_switch_delay) then
		self.indicator_time = tg
		self.work:Show(not self.work:IsShown())
	end	
	
	local hours = level.get_time_hours()
	local minutes = level.get_time_minutes()

	--log_news("hours [%s] minutes [%s]", hours, minutes)
	local hour_1, hour_2, minute_1, minute_2 = "letter_digit_0", "letter_digit_0", "letter_digit_0", "letter_digit_0"
	
	if hours < 10 then
		hour_2 = string.format("letter_digit_%s", tostring(hours):sub(1, 1))
	else
		hour_1 = string.format("letter_digit_%s", tostring(hours):sub(1, 1))
		hour_2 = string.format("letter_digit_%s", tostring(hours):sub(2, 2))	
	end

	if minutes < 10 then
		minute_2 = string.format("letter_digit_%s", tostring(minutes):sub(1, 1))
	else
		minute_1 = string.format("letter_digit_%s", tostring(minutes):sub(1, 1))
		minute_2 = string.format("letter_digit_%s", tostring(minutes):sub(2, 2))	
	end
	
	self.hour_1:InitTextureEx(hour_1, "hud\\p3d")
	self.hour_2:InitTextureEx(hour_2, "hud\\p3d")
	self.minute_1:InitTextureEx(minute_1, "hud\\p3d")
	self.minute_2:InitTextureEx(minute_2, "hud\\p3d")
	
	local _time = game.get_game_time()
	local date_str = _time:dateToString(game.CTime.DateToDay)
	local day_1, day_2, month_1, month_2, year_1, year_2
	day_1 = string.format("letter_digit_%s", date_str:sub(1, 1))
	day_2 = string.format("letter_digit_%s", date_str:sub(2, 2))
	month_1 = string.format("letter_digit_%s", date_str:sub(4, 4))
	month_2 = string.format("letter_digit_%s", date_str:sub(5, 5))
	year_1 = string.format("letter_digit_%s", date_str:sub(9, 9))
	year_2 = string.format("letter_digit_%s", date_str:sub(10, 10))	
	
	self.day_1:InitTextureEx(day_1, "hud\\p3d")
	self.day_2:InitTextureEx(day_2, "hud\\p3d")
	self.month_1:InitTextureEx(month_1, "hud\\p3d")
	self.month_2:InitTextureEx(month_2, "hud\\p3d")
	self.year_1:InitTextureEx(year_1, "hud\\p3d")
	self.year_2:InitTextureEx(year_2, "hud\\p3d")
	
	self.new_message:Show(main_window.flashing_icon:IsShown())	
end

function UISuunto:UpdateConditions()
	if not self.display_conditions:IsShown() then
	return end
	self.progress_health:SetPos(actor.health)
	self.progress_power:SetPos(actor.power)
	local bleeding = actor:get_bleeding()
	if bleeding > 0 then
		if self.bleeding_indicator_switch_delay > 0 then
			local delay = self.bleeding_indicator_switch_delay / bleeding
			local tg = time_global()
			if (tg > self.bleeding_indicator_time + delay) then
				self.bleeding_indicator_time = tg
				self.bleeding:Show(not self.bleeding:IsShown())
				if self.bleeding:IsShown() then
					local bleed_color = ui_utils.get_color_by_val(actor:get_bleeding(), 0, 1)
					self.bleeding:SetColor(bleed_color)
				end
			end
		else
			if self.bleeding:IsShown() then
				local bleed_color = ui_utils.get_color_by_val(actor:get_bleeding(), 0, 1)
				self.bleeding:SetColor(bleed_color)
			end		
		end
	else
		self.bleeding:Show(false)
	end
end

function UISuunto:UpdateNavigation()
	if not self.display_navigation:IsShown() then
	return end
	local h = device().cam_dir:getH()
end

function UISuunto:OnModeSwitch(mode, max_mode)
	if mode and max_mode then
		for i=1, max_mode do
			if self.displays then
				local display = self.displays[i]
				if display then
					display:Show(i == mode)
				end
			end
		end
	end
end

---///////////////////////////////////////////////////////////////////////////////////////////////////////

class "UILuminox" (CUIScriptWnd)
function UILuminox:__init(attachment) super()
	self:Show(true)
	self:Enable(true)

	local xml = CScriptXmlInit()
	self.xml = xml
	xml:ParseFile(OVERLAY_XML)
	local root = "display_luminox"
	xml:InitWindow(root, 0, self)
	
	root = root..":display"
	self.display = xml:InitStatic(root, self)
	
	local date_root = root..":date"
	self.date = xml:InitStatic(date_root, self.display)
	self.day_1 = xml:InitStatic(date_root..":day_1", self.date)
	self.day_2 = xml:InitStatic(date_root..":day_2", self.date)
	
	self:SetAutoDelete(true)
end

function UILuminox:__finalize() 
end

function UILuminox:Update()
	CUIScriptWnd.Update(self)
	
	local hours = level.get_time_hours()
	local minutes = level.get_time_minutes()

	local hour_angle = -(hours + minutes / 60) * time_hour_rad
	local minute_angle = -minutes * time_minute_rad

	shader_set_custom_param("clock_time_angle", hour_angle, minute_angle)
	
	local h = device().cam_dir:getH()
	shader_set_custom_param("watch_compass_params", -h, 0, 0, 0)
	
	local _time = game.get_game_time()
	local date_str = _time:dateToString(game.CTime.DateToDay)
	local day_1, day_2
	day_1 = string.format("small_digit_%s", date_str:sub(1, 1))
	day_2 = string.format("small_digit_%s", date_str:sub(2, 2))
	
	self.day_1:InitTextureEx(day_1, "hud\\p3d")
	self.day_2:InitTextureEx(day_2, "hud\\p3d")
end

